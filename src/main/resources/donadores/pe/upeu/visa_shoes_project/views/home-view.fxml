<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="24.0" styleClass="content-page home-page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="34.0" right="38.0" bottom="34.0" left="38.0" />
    </padding>
    <VBox spacing="7.0">
        <Label text="PANEL PRINCIPAL" styleClass="eyebrow" />
        <Label text="Tu tienda, en un solo lugar" styleClass="page-title" />
        <Label text="Administra el catálogo y lleva un control sencillo de tus ventas."
               wrapText="true" styleClass="page-description" />
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="welcome-banner">
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <Label text="Bienvenido a Visa Shoes" styleClass="banner-title" />
            <Label text="Elige una sección del menú para comenzar a trabajar con la información de la zapatería."
                   wrapText="true" styleClass="banner-description" />
            <Label text="CLIENTES     ·     PRODUCTOS     ·     VENTAS" styleClass="banner-caption" />
        </VBox>
        <Region minWidth="20.0" />
        <Label text="VS" styleClass="banner-mark" />
    </HBox>

    <Label text="MÓDULOS DEL SISTEMA" styleClass="section-title" />
    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <VBox spacing="12.0" styleClass="module-card" HBox.hgrow="ALWAYS">
            <Label text="01" styleClass="card-number" />
            <Label text="Clientes" styleClass="card-title" />
            <Label text="Guarda y consulta los datos de contacto de tus clientes."
                   wrapText="true" styleClass="card-description" />
        </VBox>
        <VBox spacing="12.0" styleClass="module-card" HBox.hgrow="ALWAYS">
            <Label text="02" styleClass="card-number" />
            <Label text="Productos" styleClass="card-title" />
            <Label text="Mantén organizado el catálogo, los precios y el stock."
                   wrapText="true" styleClass="card-description" />
        </VBox>
        <VBox spacing="12.0" styleClass="module-card" HBox.hgrow="ALWAYS">
            <Label text="03" styleClass="card-number" />
            <Label text="Ventas" styleClass="card-title" />
            <Label text="Registra productos vendidos y consulta las operaciones realizadas."
                   wrapText="true" styleClass="card-description" />
        </VBox>
    </HBox>
    <Label text="Selecciona una opción en la navegación para abrir el módulo correspondiente."
           wrapText="true" styleClass="page-note" />
</VBox>
