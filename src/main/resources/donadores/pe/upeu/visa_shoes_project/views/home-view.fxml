<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="content-page home-page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="28.0" right="34.0" bottom="24.0" left="34.0" />
    </padding>
    <VBox spacing="6.0">
        <Label text="BIENVENIDO A VISA SHOES" styleClass="eyebrow" />
        <Label text="Tu zapatería, con estilo y bajo control" styleClass="page-title" />
        <Label text="Administra clientes, catálogo y ventas desde un solo lugar."
               wrapText="true" styleClass="page-description" />
    </VBox>

    <StackPane fx:id="heroBanner" minHeight="235.0" prefHeight="250.0" styleClass="hero-banner">
        <padding>
            <Insets top="26.0" right="30.0" bottom="26.0" left="30.0" />
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="24.0">
            <VBox spacing="12.0" styleClass="hero-copy" HBox.hgrow="ALWAYS">
                <Label text="NUEVA TEMPORADA  ·  VISA SHOES" styleClass="hero-kicker" />
                <Label text="Elegancia para cada paso" styleClass="hero-title" wrapText="true" />
                <Label text="Organiza tus productos y ofrece una atención cercana a cada cliente."
                       styleClass="hero-description" wrapText="true" />
                <Label text="CALIDAD   ·   COMODIDAD   ·   ESTILO" styleClass="hero-tags" />
            </VBox>
            <ImageView fitHeight="210.0" fitWidth="270.0" pickOnBounds="true"
                       preserveRatio="true" smooth="true" styleClass="hero-product-image">
                <image>
                    <Image url="@../images/fondo-zapateria.jpg" />
                </image>
            </ImageView>
        </HBox>
    </StackPane>

    <Label text="GESTIONA TU TIENDA" styleClass="section-title" />
    <HBox spacing="14.0" VBox.vgrow="ALWAYS">
        <VBox spacing="10.0" styleClass="module-card" HBox.hgrow="ALWAYS">
            <Label text="01  /  ATENCIÓN" styleClass="card-number" />
            <Label text="Clientes" styleClass="card-title" />
            <Label text="Consulta y mantén actualizados los datos de tus clientes."
                   wrapText="true" styleClass="card-description" />
        </VBox>
        <VBox spacing="10.0" styleClass="module-card" HBox.hgrow="ALWAYS">
            <Label text="02  /  CATÁLOGO" styleClass="card-number" />
            <Label text="Productos" styleClass="card-title" />
            <Label text="Organiza modelos, tallas, precios y stock disponible."
                   wrapText="true" styleClass="card-description" />
        </VBox>
        <VBox spacing="10.0" styleClass="module-card" HBox.hgrow="ALWAYS">
            <Label text="03  /  VENTAS" styleClass="card-number" />
            <Label text="Ventas" styleClass="card-title" />
            <Label text="Registra compras y revisa el detalle de cada operación."
                   wrapText="true" styleClass="card-description" />
        </VBox>
    </HBox>
    <Label text="Selecciona una sección del menú para comenzar." styleClass="page-note" />
</VBox>