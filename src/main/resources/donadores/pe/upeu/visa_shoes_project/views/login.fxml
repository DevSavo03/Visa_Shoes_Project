<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16.0" prefWidth="420.0" prefHeight="360.0"
      styleClass="content-page" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="donadores.pe.upeu.visa_shoes_project.Controllers.LoginController">
    <padding>
        <Insets top="32.0" right="42.0" bottom="32.0" left="42.0" />
    </padding>
    <Label text="Visa Shoes" styleClass="page-title" />
    <Label text="Inicia sesión para administrar la zapatería." styleClass="page-description"
           wrapText="true" />
    <TextField fx:id="txtUser" promptText="Usuario" maxWidth="300.0" />
    <PasswordField fx:id="txtPassword" promptText="Contraseña" maxWidth="300.0"
                   onAction="#handleLogin" />
    <Button text="Ingresar" onAction="#handleLogin" styleClass="action-button"
            maxWidth="300.0" />
</VBox>
