<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1100.0" styleClass="app-shell" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="donadores.pe.upeu.visa_shoes_project.Controllers.MainController">
    <top>
        <VBox>
            <HBox alignment="CENTER" styleClass="announcement-bar">
                <Label styleClass="announcement-text" text="VISA SHOES  ·  CALZADO URBANO, ESTILO PARA CADA DÍA" textFill="#FFFFFF" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="topbar">
                <padding>
                    <Insets bottom="13.0" left="26.0" right="26.0" top="13.0" />
                </padding>
                <Label styleClass="brand-mark" text="VS" />
                <VBox spacing="2.0">
                    <Label styleClass="brand" text="VISA SHOES" />
                    <Label styleClass="brand-subtitle" text="URBAN FOOTWEAR" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="topbar-caption" text="GESTIÓN DE TIENDA" />
            </HBox>
        </VBox>
    </top>
    <left>
        <VBox prefWidth="218.0" spacing="8.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="14.0" right="14.0" top="24.0" />
            </padding>
            <Label styleClass="menu-caption" text="MENÚ PRINCIPAL" />
            <Button maxWidth="Infinity" onAction="#mostrarInicio" styleClass="nav-button" text="01    Inicio" />
            <Button maxWidth="Infinity" onAction="#mostrarClientes" styleClass="nav-button" text="02    Clientes" />
            <Button maxWidth="Infinity" onAction="#mostrarProductos" styleClass="nav-button" text="03    Productos" />
            <Button maxWidth="Infinity" onAction="#mostrarVentas" styleClass="nav-button" text="04    Ventas" />
        </VBox>
    </left>
    <center>
        <VBox styleClass="workspace">
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" styleClass="footer">
                <Label text="VISA SHOES  ·  CALZADO URBANO" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
