<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="content-page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="donadores.pe.upeu.visa_shoes_project.Controllers.VentaController">
    <padding>
        <Insets top="24.0" right="28.0" bottom="24.0" left="28.0" />
    </padding>
    <Label text="Ventas" styleClass="page-title" />
    <Label text="Agrega productos al detalle y registra la venta cuando esté lista."
           styleClass="page-description" wrapText="true" />

    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="form-panel">
        <padding><Insets top="12.0" right="14.0" bottom="12.0" left="14.0" /></padding>
        <Label text="Cliente" />
        <ComboBox fx:id="cbCliente" prefWidth="420.0" promptText="Selecciona un cliente registrado" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="form-panel">
        <padding>
            <Insets top="14.0" right="14.0" bottom="14.0" left="14.0" />
        </padding>
        <Label text="Producto" />
        <ComboBox fx:id="cbProducto" prefWidth="310.0" promptText="Selecciona un producto" />
        <Label text="Cantidad" />
        <TextField fx:id="txtCantidad" prefWidth="100.0" promptText="0" />
        <Button text="Agregar" onAction="#handleAgregarDetalle" styleClass="action-button" />
    </HBox>

    <TableView fx:id="tablaDetalle" prefHeight="190.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDetalleModelo" text="Producto" prefWidth="250.0" />
            <TableColumn fx:id="colDetalleCantidad" text="Cantidad" prefWidth="100.0" />
            <TableColumn fx:id="colDetallePrecio" text="Precio unitario" prefWidth="140.0" />
            <TableColumn fx:id="colDetalleImporte" text="Importe" prefWidth="140.0" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="Quitar detalle" onAction="#handleQuitarDetalle" styleClass="secondary-button" />
        <Label text="Total:" styleClass="total-caption" />
        <Label fx:id="lblTotal" text="0.00" styleClass="total-value" />
        <Button text="Registrar venta" onAction="#handleRegistrarVenta" styleClass="action-button" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Ventas registradas" styleClass="section-title" />
        <Button text="Ver detalle" onAction="#handleVerDetalleVenta" styleClass="secondary-button" />
        <Button text="Actualizar" onAction="#handleActualizar" styleClass="secondary-button" />
    </HBox>
    <TableView fx:id="tablaVentas" prefHeight="170.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colVentaId" text="N.º venta" prefWidth="100.0" />
            <TableColumn fx:id="colVentaFecha" text="Fecha" prefWidth="240.0" />
            <TableColumn fx:id="colVentaCliente" text="Cliente" prefWidth="210.0" />
            <TableColumn fx:id="colVentaTotal" text="Total" prefWidth="150.0" />
        </columns>
    </TableView>
</VBox>
