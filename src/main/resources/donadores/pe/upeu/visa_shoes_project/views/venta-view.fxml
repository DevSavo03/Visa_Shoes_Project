<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" styleClass="content-page"
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="donadores.pe.upeu.visa_shoes_project.Controllers.VentaController">
    <padding>
        <Insets top="20.0" right="26.0" bottom="18.0" left="26.0" />
    </padding>
    <VBox spacing="4.0" styleClass="page-header">
        <Label text="PUNTO DE VENTA" styleClass="eyebrow" />
        <Label text="Ventas" styleClass="page-title" />
        <Label text="Arma el pedido, revisa el total y registra la operación."
               styleClass="page-description" wrapText="true" />
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="form-panel">
        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <Label text="Cliente" styleClass="field-label" />
            <ComboBox fx:id="cbCliente" maxWidth="Infinity"
                      promptText="Selecciona un cliente registrado" />
        </VBox>
    </HBox>

    <HBox alignment="BOTTOM_LEFT" spacing="12.0" styleClass="form-panel">
        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <Label text="Producto" styleClass="field-label" />
            <ComboBox fx:id="cbProducto" maxWidth="Infinity" promptText="Selecciona un producto" />
        </VBox>
        <VBox spacing="5.0">
            <Label text="Cantidad" styleClass="field-label" />
            <TextField fx:id="txtCantidad" prefWidth="105.0" promptText="Unidades" />
        </VBox>
        <Button text="Agregar producto" onAction="#handleAgregarDetalle"
                styleClass="action-button" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Detalle de la venta" styleClass="section-title" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Quitar seleccionado" onAction="#handleQuitarDetalle"
                styleClass="secondary-button" />
    </HBox>

    <TableView fx:id="tablaDetalle" prefHeight="145.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDetalleModelo" text="Producto" prefWidth="260.0" />
            <TableColumn fx:id="colDetalleCantidad" text="Cantidad" prefWidth="110.0" />
            <TableColumn fx:id="colDetallePrecio" text="Precio unitario" prefWidth="150.0" />
            <TableColumn fx:id="colDetalleImporte" text="Importe" prefWidth="145.0" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="total-panel">
        <Label text="Total de venta" styleClass="total-caption" />
        <Label fx:id="lblTotal" text="0.00" styleClass="total-value" />
        <Button text="Registrar venta" onAction="#handleRegistrarVenta"
                styleClass="action-button" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Historial de ventas" styleClass="section-title" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Ver detalle" onAction="#handleVerDetalleVenta"
                styleClass="secondary-button" />
        <Button text="Actualizar" onAction="#handleActualizar"
                styleClass="secondary-button" />
    </HBox>
    <TableView fx:id="tablaVentas" prefHeight="125.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colVentaId" text="N.º venta" prefWidth="105.0" />
            <TableColumn fx:id="colVentaFecha" text="Fecha" prefWidth="240.0" />
            <TableColumn fx:id="colVentaCliente" text="Cliente" prefWidth="220.0" />
            <TableColumn fx:id="colVentaTotal" text="Total" prefWidth="150.0" />
        </columns>
    </TableView>
</VBox>
